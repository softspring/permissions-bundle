{
    "name": "softspring/permissions-bundle",
    "description": "Symfony permissions management bundle",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "symfony/security-bundle": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\PermissionsBundle\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
